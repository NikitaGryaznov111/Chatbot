$var: red;
.container {
  border: 1px solid rgb(49, 62, 98);
  border-radius: 6px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  cursor: text;

  &:hover,
  &:focus {
    border: 1px solid rgb(68, 94, 168);
  }
}
.activeFocus {
  border: 1px solid rgb(68, 94, 168);
}
.textarea {
  width: 100%;
  height: 100%;
  border: none;
  outline: none;
  background: none;
  box-shadow: none;
  line-height: inherit;
  resize: none;
  overflow-y: auto;
  scrollbar-width: none;
  margin-bottom: 10px;
}
.button {
  cursor: pointer;
  background-image: url('../../assets/img/tg-logo.svg');
  background-repeat: no-repeat;
  background-size: 20px;
  width: 20px;
  height: 20px;
  align-self: flex-end;
}
